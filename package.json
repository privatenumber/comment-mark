{
	"name": "comment-mark",
	"version": "0.0.0-semantic-release",
	"description": "Interpolate strings with HTML comment markers",
	"keywords": [
		"string",
		"interpolation",
		"inject",
		"html",
		"comment",
		"markdown"
	],
	"license": "MIT",
	"repository": "privatenumber/comment-mark",
	"funding": "https://github.com/privatenumber/comment-mark?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli.mjs",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"imports": {
		"#comment-mark": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.mjs"
		}
	},
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"bench": "pnpm build && node --expose-gc bench/index.ts",
		"lint": "lintroll . --cache",
		"test": "node tests/index.ts",
		"dev": "node --conditions=development tests/index.ts",
		"build": "pkgroll --target=node22.22.2",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"cleye": "^3.0.0-beta.2"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"clean-pkg-json": "^2.0.0",
		"fs-fixture": "^2.16.0",
		"lintroll": "^1.32.1",
		"manten": "^2.0.2",
		"md-pen": "^1.2.0",
		"mitata": "^1.0.34",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.28.1",
		"skills-npm": "^1.2.1",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	}
}
