{
  "name": "comment-mark",
  "version": "0.0.0-semantic-release",
  "description": "Interpolate strings with HTML comment markers",
  "keywords": [
    "string",
    "interpolation",
    "inject",
    "html",
    "comment",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "privatenumber/comment-mark"
  },
  "funding": "https://github.com/privatenumber/comment-mark?sponsor=1",
  "author": {
    "name": "Hiroki Osame",
    "email": "hiroki.osame@gmail.com"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "bin": {
    "comment-mark": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "imports": {
    "#comment-mark": {
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "cleye": "^3.0.0-beta.2"
  }
}